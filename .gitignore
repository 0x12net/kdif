.venv/
venv/
env/
ENV/

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Tool output (generated diff viewers)
*-diff.html

